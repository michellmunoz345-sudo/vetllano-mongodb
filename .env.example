# Copia este archivo como ".env" y reemplaza los valores de ejemplo.
# El archivo ".env" NO se sube a GitHub (esta en .gitignore).
# Nunca escribas contrasenas reales en este .env.example.

# Cadena de conexion del USUARIO DE APLICACION (rol readWrite solo sobre vetllano).
# Formato: mongodb://USUARIO:CONTRASENA@HOST:PUERTO/BASE?authSource=BASE
# Consejo: usa una contrasena solo con letras y numeros; si lleva simbolos
# (@ : / ? #) hay que codificarlos en la URL (ej. @ -> %40).
MONGO_URI=mongodb://app_vetllano:CAMBIAR_POR_TU_CONTRASENA@localhost:27017/vetllano?authSource=vetllano

# Nombre de la base de datos del proyecto
MONGO_DB=vetllano
